{
  "expo": {
    "name": "Prent",
    "slug": "prent",
    "version": "1.0.0",
    "scheme": "prent",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "me.amees.prent"
    },
    "android": {
      "package": "me.amees.prent",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Prent gebruikt je camera als viewfinder om foto's in je envelop te vegen."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Prent bewaart de foto's die je maakt in je fotobibliotheek.",
          "savePhotosPermission": "Prent bewaart de foto's die je maakt in je fotobibliotheek.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "784f31ca-6d7d-475c-a168-ae6641133751"
      }
    },
    "owner": "ameesme",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/784f31ca-6d7d-475c-a168-ae6641133751"
    }
  }
}
